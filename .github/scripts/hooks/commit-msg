#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 Tanner Golden
# SPDX-License-Identifier: MIT
#
# Checks a commit message before git records it: a Conventional Commit
# header with a scope, the Signed-off-by trailer the DCO check requires, and
# who the commit is by.
#
# WHY A LOCAL COPY OF A RULE CI ALREADY HOLDS. The pull request runs the
# canonical checks - ✍️ Commit Messages and ✍️ DCO Sign-Off, from
# tannergolden/standards - and they stay the authority. But they run after a
# push, and a commit that fails them has to be rewritten: an amend, or an
# interactive rebase across every commit on the branch. This catches the
# same mistakes while they still cost nothing. Where this file and the
# standards disagree, the standards win; the rules below follow
# commit-check.py and dco-check.sh there.
#
# Enable it once per clone (the development container does it for you):
#
#     git config core.hooksPath .github/scripts/hooks
#
# `git commit --no-verify` skips it, and CI still checks the result. So does
# `git revert`, which runs no commit-msg hook: reword its `Revert "..."`
# message as `revert(<scope>): ...` before you push, or CI rejects it.

from __future__ import annotations

import os
import re
import subprocess
import sys

TYPES = ('feat', 'fix', 'docs', 'style', 'refactor', 'perf', 'test', 'build',
         'ci', 'chore', 'revert', 'security')
MAX_HEADER = 100

HEADER = re.compile(
    r'^(?P<type>[a-z]+)\((?P<scope>[a-z0-9][a-z0-9-]*)\)(?P<breaking>!)?: (?P<subject>.+)$'
)
UNSCOPED = re.compile(r'^(?P<type>[a-z]+)(?P<breaking>!)?: ')

# An optional leading emoji and a space, as the standards' checker reads it.
EMOJI_PREFIX = re.compile(
    '^[\U0001F000-\U0001FAFF\u2190-\u21FF\u2300-\u27BF\u2900-\u2BFF]\uFE0F?\\s'
)

# U+2013 EN DASH through U+2015 HORIZONTAL BAR: the em dash is the banned
# character, and its neighbours go with it. Escapes, so this file holds none.
BANNED_DASHES = re.compile('[\u2013-\u2015]')

# Read without regard to case, as CI reads it.
SIGNOFF = re.compile(r'(?im)^signed-off-by:\s*(.+?)\s*$')

# An AI is credited with Co-Authored-By and is never the author and never
# signs off; the person contributing the change does both.
AI_IDENTITY = re.compile(
    r'\b(claude|anthropic|openai|chatgpt|codex|copilot|gemini|antigravity|cursor|grok|x\.ai|devin)\b',
    re.I,
)

# Messages a later rebase discards or rewrites in its own editor, where no
# hook runs: a fixup! commit's message is dropped, and a squash! commit's is
# combined by hand. An amend! commit's body REPLACES its target's message,
# so that body is checked as the message it will become.
DISCARDED_PREFIXES = ('fixup! ', 'squash! ')
AMEND_PREFIX = 'amend! '

# Git's scissors line, with whatever comment character is in use.
SCISSORS = re.compile(r'^(?P<char>\S) -{24} >8 -{24}$')


def git(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(['git', *args], capture_output=True, text=True, check=False)


def comment_char() -> str:
    """The character git strips comment lines by: core.commentChar, else `#`.

    `auto` means git picked one the message does not use; the scissors line,
    when there is one, still says which.
    """
    configured = git('config', 'core.commentChar').stdout.strip()
    return configured if configured and configured != 'auto' else '#'


def cleaned(raw: str, char: str) -> str:
    """The message as git will store it: no comment lines, nothing past the scissors."""
    lines = raw.splitlines()
    for line in lines:
        found = SCISSORS.match(line)
        if found:
            char = found.group('char')
            break
    kept = []
    for line in lines:
        found = SCISSORS.match(line)
        if found and found.group('char') == char:
            break
        if line.startswith(char):
            continue
        kept.append(line.rstrip())
    return '\n'.join(kept).strip('\n')


def author() -> tuple[str, str]:
    """Who git will record as the author, `--author` included, or two empty strings."""
    ident = git('var', 'GIT_AUTHOR_IDENT').stdout
    found = re.match(r'^(?P<name>.*?) <(?P<email>[^>]*)>', ident)
    if found:
        return found.group('name').strip(), found.group('email').strip()
    return os.environ.get('GIT_AUTHOR_NAME', '').strip(), os.environ.get('GIT_AUTHOR_EMAIL', '').strip()


def merging() -> bool:
    """Whether this commit concludes a merge. CI exempts a commit by its two
    parents, never by its wording, so the hook asks git the same question."""
    return git('rev-parse', '-q', '--verify', 'MERGE_HEAD').returncode == 0


def problems(message: str, name: str = '', email: str = '') -> list[str]:
    found: list[str] = []
    header = message.split('\n', 1)[0].rstrip()

    if len(header) > MAX_HEADER:
        found.append(f'the subject line is {len(header)} characters (limit {MAX_HEADER})')

    match = HEADER.match(header)
    if not match:
        loose = UNSCOPED.match(header)
        if loose:
            found.append(
                f'`{loose.group("type")}:` has no scope - write `{loose.group("type")}(<scope>):`, '
                'where the scope names the area changed (workflows, scripts, docs, deps, readme)'
            )
        else:
            found.append('the subject line does not match `<type>(<scope>): <subject>`')
    elif match.group('type') not in TYPES:
        found.append(f'`{match.group("type")}` is not an allowed type ({", ".join(TYPES)})')
    else:
        subject = EMOJI_PREFIX.sub('', match.group('subject'))
        if not subject[:1].islower() or not subject[:1].isascii():
            found.append('the subject must start with a lowercase letter, optionally after an emoji and a space')

    if BANNED_DASHES.search(message):
        found.append('it contains an em dash (use a comma, a colon, or a spaced hyphen)')

    signers = SIGNOFF.findall(message)
    if not signers:
        found.append('it has no `Signed-off-by:` trailer - commit with `git commit -s`, or add it with `git commit --amend -s`')
    for signer in signers:
        if AI_IDENTITY.search(signer):
            found.append(
                f'it is signed off by an AI ({signer}); the person contributing it signs off, '
                'and the AI is credited with Co-Authored-By'
            )

    # Who it is by, as CI's identity check reads it: never an AI, and one of
    # its sign-offs must be the author's own.
    if name or email:
        if AI_IDENTITY.search(f'{name} {email}'):
            found.append(
                f'its author is an AI ({name} <{email}>); author it as the person contributing it, '
                'with `git commit --author`'
            )
        elif signers and not any(signer.lower() == f'{name} <{email}>'.lower() for signer in signers):
            found.append(
                f'no sign-off is its author\'s ({name} <{email}>); add it with '
                f"`--trailer 'Signed-off-by: {name} <{email}>'`"
            )
    return found


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print('usage: commit-msg <path to the commit message file>', file=sys.stderr)
        return 2
    with open(argv[1], encoding='utf-8') as handle:
        message = cleaned(handle.read(), comment_char())
    if not message or merging() or message.startswith(DISCARDED_PREFIXES):
        return 0
    if message.startswith(AMEND_PREFIX):
        message = message.split('\n', 1)[1].strip('\n') if '\n' in message else ''
        if not message:
            return 0
    found = problems(message, *author())
    if not found:
        return 0
    print('commit-msg: this commit message would fail the pull request checks:', file=sys.stderr)
    for problem in found:
        print(f'  - {problem}', file=sys.stderr)
    print(
        'The full rules: https://github.com/tannergolden/standards/blob/Development/docs/distribution/Conventional-Commits.md\n'
        'Your message is kept in .git/COMMIT_EDITMSG. Skip this check with --no-verify; CI still runs it.',
        file=sys.stderr,
    )
    return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
